#!/busybox sh
# Nura test init: load vendor modules, start USB NCM gadget + telnet, log to kmsg ("nura:" prefix)
/busybox mkdir -p /nb /proc /sys /dev /config
/busybox --install -s /nb
export PATH=/nb
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/null ] || mknod /dev/null c 1 3
log(){ echo "nura: $*" > /dev/kmsg; }
log "init start, modules dir: $(ls /lib/modules 2>/dev/null | wc -l) files"
for m in $(cat /lib/modules/modules.load.recovery); do
  insmod /lib/modules/$m 2>/dev/null && log "ok $m" || log "FAIL $m"
done
mdev -s
log "modules done"
for w in /dev/watchdog /dev/watchdog0; do
  if [ -e $w ]; then log "wdt $w"; ( while :; do echo . > $w; sleep 3; done ) & break; fi
done
mkdir -p /dev/pts; mount -t devpts devpts /dev/pts
mount -t configfs none /config
G=/config/usb_gadget/g1
mkdir $G
echo 0x18d1 > $G/idVendor; echo 0xd001 > $G/idProduct
mkdir $G/strings/0x409
echo nura > $G/strings/0x409/serialnumber
echo Nura > $G/strings/0x409/manufacturer
echo "Nura C51" > $G/strings/0x409/product
mkdir $G/configs/c.1 $G/functions/ncm.usb0
ln -s $G/functions/ncm.usb0 $G/configs/c.1/
i=0
while [ -z "$(ls /sys/class/udc 2>/dev/null)" ] && [ $i -lt 60 ]; do sleep 1; i=$((i+1)); done
UDC=$(ls /sys/class/udc | head -n1)
log "udc=$UDC"
echo "$UDC" > $G/UDC
sleep 1
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up
telnetd -b 172.16.42.1 -l /nb/sh &
log "ready: telnet 172.16.42.1"
while :; do sleep 3600; done
